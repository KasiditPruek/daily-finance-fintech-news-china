  "featured": [
    {
      "hanzi": "跨境",
      "pinyin": "kuàjìng",
      "pos": "adjective / adverb",
      "en": "cross-border",
      "note": "常见搭配：跨境支付、跨境电商、跨境汇款。Common collocations: cross-border payment, cross-border e-commerce, cross-border remittance.",
      "examples": [
        {
          "zh": "这个钱包支持跨境支付，出国旅行很方便。",
          "py": "Zhège qiánbāo zhīchí kuàjìng zhīfù, chūguó lǚxíng hěn fāngbiàn.",
          "en": "This wallet supports cross-border payment, so it is very convenient for travelling abroad."
        },
        {
          "zh": "我朋友在一家跨境电商公司工作。",
          "py": "Wǒ péngyou zài yì jiā kuàjìng diànshāng gōngsī gōngzuò.",
          "en": "My friend works at a cross-border e-commerce company."
        },
        {
          "zh": "我们的平台上个月跨境交易的数量增加了一倍。",
          "py": "Wǒmen de píngtái shàng gè yuè kuàjìng jiāoyì de shùliàng zēngjiāle yí bèi.",
          "en": "The number of cross-border transactions on our platform doubled last month."
        }
      ]
    },
    {
      "hanzi": "商户",
      "pinyin": "shānghù",
      "pos": "noun",
      "en": "merchant",
      "note": "常见搭配：合作商户、商户收款、小微商户。Common collocations: partner merchant, merchant collection, small and micro merchants.",
      "examples": [
        {
          "zh": "越来越多的商户接受扫码支付。",
          "py": "Yuèláiyuè duō de shānghù jiēshòu sǎomǎ zhīfù.",
          "en": "More and more merchants accept QR code payment."
        },
        {
          "zh": "这家小店是我们的合作商户，买东西可以打折。",
          "py": "Zhè jiā xiǎo diàn shì wǒmen de hézuò shānghù, mǎi dōngxi kěyǐ dǎzhé.",
          "en": "This little shop is our partner merchant, and you get a discount when you buy things."
        },
        {
          "zh": "我们要分析商户每天的收款数据，看看哪些商户用得最多。",
          "py": "Wǒmen yào fēnxī shānghù měi tiān de shōukuǎn shùjù, kànkan nǎxiē shānghù yòng de zuì duō.",
          "en": "We need to analyse merchants' daily collection data and see which merchants use it the most."
        }
      ]
    }
  ]
