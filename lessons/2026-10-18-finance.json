  "featured": [
    {
      "hanzi": "加息",
      "pinyin": "jiāxī",
      "pos": "verb (also noun)",
      "en": "to raise interest rates; a rate hike",
      "note": "The opposite is 降息 (jiàngxī, to cut rates). Common collocations: 加息0.25个百分点、再次加息、暂停加息、加息周期. In more formal writing you will also see 上调利率 / 下调利率.",
      "examples": [
        {
          "zh": "美联储决定加息0.25个百分点。",
          "py": "Měiliánchǔ juédìng jiāxī líng diǎn èr wǔ gè bǎifēndiǎn.",
          "en": "The Fed decided to raise rates by 0.25 percentage points."
        },
        {
          "zh": "银行加息以后，我把钱存在银行能拿到更多利息。",
          "py": "Yínháng jiāxī yǐhòu, wǒ bǎ qián cún zài yínháng néng nádào gèng duō lìxī.",
          "en": "After the bank raised rates, I can earn more interest on the money I keep there."
        },
        {
          "zh": "如果央行继续加息，买房的人会觉得压力更大。",
          "py": "Rúguǒ yāngháng jìxù jiāxī, mǎi fáng de rén huì juéde yālì gèng dà.",
          "en": "If the central bank keeps raising rates, home buyers will feel more pressure."
        }
      ]
    },
    {
      "hanzi": "通胀",
      "pinyin": "tōngzhàng",
      "pos": "noun",
      "en": "inflation",
      "note": "Short for 通货膨胀 (tōnghuò péngzhàng). Common collocations: 通胀率 (inflation rate)、通胀压力、控制通胀、抗通胀 / 对抗通胀. The opposite is 通缩 (deflation).",
      "examples": [
        {
          "zh": "美国9月的通胀率达到3.7%。",
          "py": "Měiguó jiǔ yuè de tōngzhànglǜ dádào bǎifēnzhī sān diǎn qī.",
          "en": "US inflation reached 3.7% in September."
        },
        {
          "zh": "因为通胀，现在一百块钱能买的东西比以前少了。",
          "py": "Yīnwèi tōngzhàng, xiànzài yìbǎi kuài qián néng mǎi de dōngxi bǐ yǐqián shǎo le.",
          "en": "Because of inflation, 100 yuan buys less now than it used to."
        },
        {
          "zh": "很多人买黄金，是为了对抗通胀。",
          "py": "Hěn duō rén mǎi huángjīn, shì wèile duìkàng tōngzhàng.",
          "en": "Many people buy gold to protect themselves against inflation."
        }
      ]
    }
  ],
