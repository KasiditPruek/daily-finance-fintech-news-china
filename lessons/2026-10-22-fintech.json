  "featured": [
    {
      "hanzi": "智能合约",
      "pinyin": "zhìnéng héyuē",
      "pos": "noun",
      "en": "smart contract",
      "note": "Code that moves money automatically when preset conditions are met. Collocations: 智能合约支付, 部署智能合约, 智能合约平台.",
      "examples": [
        {
          "zh": "数字人民币的智能合约可以让补贴自动发到企业账户。",
          "py": "Shùzì rénmínbì de zhìnéng héyuē kěyǐ ràng bǔtiē zìdòng fā dào qǐyè zhànghù.",
          "en": "The digital yuan's smart contracts can send subsidies automatically to companies' accounts."
        },
        {
          "zh": "我开玩笑说，要是房租也用智能合约，房东就不用每个月提醒我了。",
          "py": "Wǒ kāi wánxiào shuō, yàoshi fángzū yě yòng zhìnéng héyuē, fángdōng jiù búyòng měi gè yuè tíxǐng wǒ le.",
          "en": "I joked that if rent used a smart contract too, my landlord wouldn't have to remind me every month."
        },
        {
          "zh": "我们要统计用智能合约付款的商户数量，看看这个功能有没有人用。",
          "py": "Wǒmen yào tǒngjì yòng zhìnéng héyuē fùkuǎn de shānghù shùliàng, kànkan zhège gōngnéng yǒu méiyǒu rén yòng.",
          "en": "We need to count how many merchants pay via smart contracts, to see whether anyone uses this feature."
        }
      ]
    },
    {
      "hanzi": "跨境",
      "pinyin": "kuàjìng",
      "pos": "adjective (attributive)",
      "en": "cross-border",
      "note": "跨 = to cross, 境 = border. Used before nouns: 跨境支付, 跨境电商, 跨境结算, 跨境汇款.",
      "examples": [
        {
          "zh": "中国和泰国之间的跨境支付越来越方便了。",
          "py": "Zhōngguó hé Tàiguó zhījiān de kuàjìng zhīfù yuè lái yuè fāngbiàn le.",
          "en": "Cross-border payments between China and Thailand are getting more and more convenient."
        },
        {
          "zh": "我妈妈经常在跨境电商网站上买日本的护肤品。",
          "py": "Wǒ māma jīngcháng zài kuàjìng diànshāng wǎngzhàn shang mǎi Rìběn de hùfūpǐn.",
          "en": "My mom often buys Japanese skincare on cross-border e-commerce websites."
        },
        {
          "zh": "这个月跨境交易的笔数比上个月增加了百分之十五。",
          "py": "Zhège yuè kuàjìng jiāoyì de bǐshù bǐ shàng gè yuè zēngjiāle bǎi fēn zhī shíwǔ.",
          "en": "This month the number of cross-border transactions rose 15% compared with last month."
        }
      ]
    }
  ],
