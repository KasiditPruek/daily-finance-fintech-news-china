    {
      "hanzi": "无感支付",
      "pinyin": "wúgǎn zhīfù",
      "pos": "noun",
      "en": "frictionless payment; paying without any action by the customer",
      "note": "Common collocations: 开通无感支付, 停车场无感支付, 无感支付场景.",
      "examples": [
        {
          "zh": "很多市场开始使用无感支付，顾客不用排队付款。",
          "py": "Hěn duō shìchǎng kāishǐ shǐyòng wúgǎn zhīfù, gùkè búyòng páiduì fùkuǎn.",
          "en": "Many markets have started to use frictionless payment, so customers do not need to queue to pay."
        },
        {
          "zh": "我在停车场开通了无感支付，出门不用停车交钱。",
          "py": "Wǒ zài tíngchēchǎng kāitōngle wúgǎn zhīfù, chūmén búyòng tíngchē jiāo qián.",
          "en": "I activated frictionless payment at the car park, so I don't need to stop and pay when I leave."
        },
        {
          "zh": "我们的平台想看看，开通无感支付的商户有多少。",
          "py": "Wǒmen de píngtái xiǎng kànkan, kāitōng wúgǎn zhīfù de shānghù yǒu duōshao.",
          "en": "Our platform wants to see how many merchants have activated frictionless payment."
        }
      ]
    },
    {
      "hanzi": "结算",
      "pinyin": "jiésuàn",
      "pos": "verb / noun",
      "en": "to settle accounts; settlement",
      "note": "Common collocations: 电子结算, 每日结算, 跨境结算, 结算账户.",
      "examples": [
        {
          "zh": "商户今天收的钱，明天就可以结算到账户里。",
          "py": "Shānghù jīntiān shōu de qián, míngtiān jiù kěyǐ jiésuàn dào zhànghù lǐ.",
          "en": "The money a merchant receives today can be settled into their account tomorrow."
        },
        {
          "zh": "旅游结束后，我们在前台结算房费。",
          "py": "Lǚyóu jiéshù hòu, wǒmen zài qiántái jiésuàn fángfèi.",
          "en": "After the trip ended, we settled the hotel bill at the front desk."
        },
        {
          "zh": "分析平台数据时，我们要看每天的结算金额。",
          "py": "Fēnxī píngtái shùjù shí, wǒmen yào kàn měitiān de jiésuàn jīn'é.",
          "en": "When analysing platform data, we look at the daily settlement amount."
        }
      ]
    }
